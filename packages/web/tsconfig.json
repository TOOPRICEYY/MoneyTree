{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"]
  },
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../ui"
    }
  ],
  "include": ["src", "vite.config.ts"]
}
