# Local Actual Budget sync server (see Accountable/actual-budget)
ACTUAL_SERVER_URL=http://127.0.0.1:5006
ACTUAL_PASSWORD=
# Budget sync id from Actual: Settings > Advanced > Sync ID
ACTUAL_SYNC_ID=
# Where @actual-app/api caches the budget locally
ACTUAL_DATA_DIR=./data/actual-cache

# Email: "gmail" (REST API, run `yarn moneytree auth gmail` once) or "imap"
EMAIL_PROVIDER=gmail
# Gmail API OAuth client (Google Cloud console > Credentials > Desktop app)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# IMAP works with Gmail, iCloud, Zoho, Outlook using an app password
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=[Gmail]/All Mail

# Knot TransactionLink (itemized Amazon/Costco orders), from dashboard.knotapi.com
KNOT_CLIENT_ID=
KNOT_SECRET=
KNOT_ENV=development
KNOT_EXTERNAL_USER_ID=moneytree
